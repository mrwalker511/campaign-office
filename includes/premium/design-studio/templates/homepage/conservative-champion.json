  "custom_css": "/* Conservative Champion Custom Styles */\n.cp-conservative-champion {\n  font-family: 'Georgia', 'Times New Roman', serif;\n}\n\n.cp-conservative-champion h1, .cp-conservative-champion h2 {\n  font-weight: 700;\n  letter-spacing: 0.02em;\n}\n\n.cp-conservative-champion .cp-patriotic-bg {\n  background: linear-gradient(135deg, #002868 0%, #8B0000 100%);\n}\n\n.cp-conservative-champion .cp-button-red {\n  background: #CC0000;\n  border: 2px solid #8B0000;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.cp-conservative-champion .cp-button-red:hover {\n  background: #8B0000;\n}",
