{
  "name": "campaign-office/wordpress-theme",
  "description": "Campaign Office WordPress Theme - Testing Framework",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.0",
    "wp-phpunit/wp-phpunit": "^6.1",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "scripts": {
    "test": "phpunit --configuration tests/phpunit.xml.dist",
    "test:coverage": "phpunit --configuration tests/phpunit.xml.dist --coverage-html coverage",
    "phpcs": "phpcs --standard=build/phpcs.xml.dist includes/ blocks/ *.php",
    "phpcbf": "phpcbf --standard=build/phpcs.xml.dist includes/ blocks/ *.php",
    "phpcs:theme": "phpcs --standard=WordPress-Theme --runtime-set testVersion 7.4- .",
    "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' | xargs -n 1 php -l"
  },
  "autoload-dev": {
    "psr-4": {
      "CampaignOffice\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}