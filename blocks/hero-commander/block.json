{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "campaignpress/hero-commander",
    "version": "2.0.0",
    "title": "Hero Commander",
    "category": "campaign-office",
    "icon": "superhero",
    "description": "Advanced hero section with background media, typewriter effects, and full customization.",
    "keywords": ["hero", "header", "banner", "campaign", "parallax"],
    "supports": {
        "html": false,
        "align": ["full"],
        "anchor": true,
        "spacing": {
            "padding": true,
            "margin": true
        }
    },
    "attributes": {
        "headline": {
            "type": "string",
            "default": "Leading with Integrity"
        },
        "subheadline": {
            "type": "string",
            "default": "Building a Better Future Together"
        },
        "typewriterEnabled": {
            "type": "boolean",
            "default": true
        },
        "typewriterTexts": {
            "type": "array",
            "default": ["Vision", "Courage", "Values", "Leadership"]
        },
        "typewriterSpeed": {
            "type": "number",
            "default": 100
        },
        "backgroundType": {
            "type": "string",
            "default": "image",
            "enum": ["image", "video", "gradient", "color"]
        },
        "backgroundImage": {
            "type": "object",
            "default": {
                "url": "",
                "id": 0,
                "alt": ""
            }
        },
        "backgroundVideo": {
            "type": "object",
            "default": {
                "url": "",
                "id": 0
            }
        },
        "backgroundColor": {
            "type": "string",
            "default": "#0053c3"
        },
        "gradientColors": {
            "type": "object",
            "default": {
                "start": "#0053c3",
                "end": "#003275"
            }
        },
        "overlayEnabled": {
            "type": "boolean",
            "default": true
        },
        "overlayColor": {
            "type": "string",
            "default": "#000000"
        },
        "overlayOpacity": {
            "type": "number",
            "default": 0.5
        },
        "minHeight": {
            "type": "string",
            "default": "100vh"
        },
        "textAlign": {
            "type": "string",
            "default": "center",
            "enum": ["left", "center", "right"]
        },
        "textColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "headlineSize": {
            "type": "string",
            "default": "clamp(2.5rem, 5vw, 5rem)"
        },
        "subheadlineSize": {
            "type": "string",
            "default": "clamp(1.25rem, 2.5vw, 2rem)"
        },
        "contentMaxWidth": {
            "type": "string",
            "default": "900px"
        },
        "primaryCTA": {
            "type": "object",
            "default": {
                "text": "Donate Now",
                "url": "#donate",
                "enabled": true
            }
        },
        "secondaryCTA": {
            "type": "object",
            "default": {
                "text": "Get Involved",
                "url": "#volunteer",
                "enabled": true
            }
        },
        "parallaxEnabled": {
            "type": "boolean",
            "default": false
        },
        "animationStyle": {
            "type": "string",
            "default": "fade-up",
            "enum": ["none", "fade-up", "fade-in", "slide-up", "zoom-in"]
        }
    },
    "textdomain": "campaign-office",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "viewScript": "file:./view.js",
    "render": "file:./render.php",
    "style": "file:./style.css"
}
