{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "campaignpress/countdown",
    "version": "1.0.0",
    "title": "Election Countdown",
    "category": "campaign-office",
    "icon": "clock",
    "description": "A real-time countdown timer to election day.",
    "supports": {
        "html": false,
        "align": true,
        "color": {
            "text": true,
            "background": true
        }
    },
    "attributes": {
        "targetDate": {
            "type": "string",
            "default": ""
        },
        "headline": {
            "type": "string",
            "default": "Election Day Countdown"
        }
    },
    "textdomain": "campaign-office",
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "render": "file:./render.php",
    "style": "file:./style.css"
}