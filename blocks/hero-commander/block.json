{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "campaignpress/hero-commander",
    "version": "1.0.0",
    "title": "Hero Commander",
    "category": "campaign-office",
    "icon": "superhero",
    "description": "Premium parallax section with typewriter text effects.",
    "supports": {
        "html": false,
        "align": [
            "full"
        ]
    },
    "attributes": {
        "headline": {
            "type": "string",
            "default": "Leading with Integrity"
        },
        "typewriterText": {
            "type": "array",
            "default": [
                "Vision",
                "Courage",
                "Values"
            ]
        },
        "backgroundImage": {
            "type": "string",
            "default": ""
        }
    },
    "textdomain": "campaign-office",
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "render": "file:./render.php",
    "style": "file:./style.css"
}