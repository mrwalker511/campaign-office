<?xml version="1.0"?>
<ruleset name="Campaign Office Theme Coding Standards">
    <description>Coding standards for Campaign Office WordPress Theme</description>

    <!-- Check all PHP files -->
    <file>.</file>

    <!-- Exclude paths -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>

    <!-- Use WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Use WordPress Theme Coding Standards -->
    <rule ref="WordPress-Theme">
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!-- Use WordPress Extra Standards -->
    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <!-- Check for PHP cross-version compatibility -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="campaign-office"/>
            </property>
        </properties>
    </rule>

    <!-- Prefix for hooks and functions -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="campaign_office"/>
                <element value="co"/>
            </property>
        </properties>
    </rule>

    <!-- Show colors in output -->
    <arg name="colors"/>

    <!-- Show progress -->
    <arg value="sp"/>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>
</ruleset>
