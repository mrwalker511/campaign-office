{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "campaignpress/hero-commander",
    "version": "2.0.0",
    "title": "Hero Commander",
    "category": "campaign-office",
    "icon": "cover-image",
    "description": "Dynamic hero sections with typewriter effects, parallax backgrounds, and call-to-action buttons.",
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "color": {
            "text": true,
            "background": true,
            "gradients": true
        },
        "spacing": {
            "padding": true,
            "margin": true
        }
    },
    "attributes": {
        "headline": {
            "type": "string",
            "default": "Fighting for Our Future"
        },
        "subheadline": {
            "type": "string",
            "default": "Together, we can build a better tomorrow"
        },
        "typewriterEnabled": {
            "type": "boolean",
            "default": false
        },
        "typewriterTexts": {
            "type": "array",
            "default": ["Fighting for Our Future", "Building a Better Tomorrow", "Working for Change"]
        },
        "typewriterSpeed": {
            "type": "number",
            "default": 100
        },
        "backgroundType": {
            "type": "string",
            "default": "color"
        },
        "backgroundImage": {
            "type": "object",
            "default": {
                "url": "",
                "id": 0,
                "alt": ""
            }
        },
        "backgroundVideo": {
            "type": "object",
            "default": {
                "url": "",
                "id": 0
            }
        },
        "backgroundColor": {
            "type": "string",
            "default": "#14213d"
        },
        "gradientColors": {
            "type": "object",
            "default": {
                "start": "#14213d",
                "end": "#ff8800"
            }
        },
        "overlayEnabled": {
            "type": "boolean",
            "default": false
        },
        "overlayColor": {
            "type": "string",
            "default": "rgba(0, 0, 0, 0.5)"
        },
        "overlayOpacity": {
            "type": "number",
            "default": 0.5
        },
        "minHeight": {
            "type": "string",
            "default": "600px"
        },
        "textAlign": {
            "type": "string",
            "default": "center"
        },
        "textColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "headlineSize": {
            "type": "string",
            "default": "clamp(2rem, 5vw, 4rem)"
        },
        "subheadlineSize": {
            "type": "string",
            "default": "1.25rem"
        },
        "contentMaxWidth": {
            "type": "string",
            "default": "800px"
        },
        "primaryCTA": {
            "type": "object",
            "default": {
                "enabled": true,
                "text": "Donate Now",
                "url": ""
            }
        },
        "secondaryCTA": {
            "type": "object",
            "default": {
                "enabled": true,
                "text": "Get Involved",
                "url": ""
            }
        },
        "parallaxEnabled": {
            "type": "boolean",
            "default": false
        },
        "animationStyle": {
            "type": "string",
            "default": "none"
        }
    },
    "textdomain": "campaign-office",
    "editorScript": "file:./index.js",
    "render": "file:./render.php"
}
