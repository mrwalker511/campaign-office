{
  "template_key": "quick_donate",
  "template_name": "Quick Donate",
  "template_description": "Fast, mobile-optimized donation page. Minimal friction, maximum conversions. Perfect for text-to-donate and mobile traffic.",
  "category": "landing_pages",
  "campaign_type": "all",
  "election_level": "all",
  "tags": ["donation", "mobile", "quick", "express", "conversion"],
  "is_premium": true,
  "featured": false,
  "difficulty": "beginner",
  "estimated_setup_time": "3 minutes",
  "conversion_optimized": true,
  "mobile_first": true,
  "color_scheme": {
    "primary": "#d63638"
  },
  "components": [
    {
      "type": "hero",
      "variant": "minimal",
      "order": 1,
      "settings": {
        "headline": "Support Our Campaign",
        "subheadline": "Every dollar makes a difference",
        "height": "40vh",
        "background": "#d63638",
        "text_color": "#ffffff"
      }
    },
    {
      "type": "donation",
      "variant": "quick-donate",
      "order": 2,
      "settings": {
        "tiers": [
          {"amount": 10},
          {"amount": 25, "popular": true},
          {"amount": 50},
          {"amount": 100},
          {"amount": 250},
          {"amount": 500}
        ],
        "express_checkout": {"enabled": true, "options": ["apple_pay", "google_pay"]},
        "form_fields": ["amount", "email"],
        "one_click": true
      }
    },
    {
      "type": "stats",
      "variant": "progress-bars",
      "order": 3,
      "settings": {
        "stats": [
          {"label": "Goal Progress", "current": 67500, "goal": 100000, "format": "currency"}
        ]
      }
    }
  ],
  "seo": {
    "title": "Donate - {{Candidate Name}}",
    "description": "Support our campaign with a quick, secure donation."
  },
  "credits": {"version": "1.0.0"}
}
