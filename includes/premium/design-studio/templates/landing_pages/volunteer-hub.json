    {
      "type": "cta",
      "variant": "card",
      "order": 6,
      "settings": {
        "section_id": "signup-form",
        "layout": "form-card",
        "headline": "Ready to Make a Difference?",
        "subheadline": "Sign up now and we'll match you with the perfect volunteer opportunity",
        "background": "#ffffff",
        "padding": "80px-0",
        "form": {
          "enabled": true,
          "fields": [
            {"name": "name", "type": "text", "label": "Full Name", "required": true, "placeholder": "Your name"},
            {"name": "email", "type": "email", "label": "Email", "required": true, "placeholder": "your@email.com"},
            {"name": "phone", "type": "tel", "label": "Phone", "required": true, "placeholder": "(555) 123-4567"},
            {"name": "zip", "type": "text", "label": "Zip Code", "required": true, "placeholder": "12345"},
            {"name": "interests", "type": "checkbox-group", "label": "I'm interested in (select all that apply):", "required": true, "options": [
              "Phone Banking",
              "Canvassing",
              "Event Support",
              "Social Media",
              "Data Entry",
              "Creative Team",
              "Other"
            ]},
            {"name": "availability", "type": "select", "label": "Time Commitment", "required": true, "options": [
              "1-2 hours/week",
              "3-5 hours/week",
              "5-10 hours/week",
              "10+ hours/week",
              "Just special events"
            ]},
            {"name": "experience", "type": "radio", "label": "Campaign Experience", "required": false, "options": [
              "First time volunteering",
              "Some experience",
              "Experienced volunteer"
            ]},
            {"name": "message", "type": "textarea", "label": "Questions or Comments", "required": false, "placeholder": "Tell us anything else..."}
          ],
          "submit_text": "Sign Me Up!",
          "submit_style": "primary-large-green",
          "success_message": "Thank you! We'll be in touch within 24 hours with your first opportunity.",
          "redirect_url": "/thank-you-volunteer"
        },
        "trust_signals": [
          {"icon": "🔒", "text": "Your info is safe and never sold"},
          {"icon": "✅", "text": "Quick response - usually within 24hrs"},
          {"icon": "💪", "text": "Flexible schedule - work when you can"}
        ],
        "animation": "scale-in"
      }
    },
    {
      "type": "faq",
      "variant": "accordion",
      "order": 7,
      "settings": {
        "section_headline": "Volunteer FAQs",
        "background": "#f8f9fa",
        "padding": "60px-0-80px",
        "layout": "single-column",
        "faqs": [
          {
            "question": "I've never volunteered before. Can I still help?",
            "answer": "Absolutely! Most of our volunteers are first-timers. We provide full training for all activities and pair you with experienced volunteers when you start. Everyone begins somewhere!"
          },
          {
            "question": "How much time do I need to commit?",
            "answer": "As little or as much as you can! We have opportunities from 1 hour/week to full-time organizing. Even small contributions make a huge difference."
          },
          {
            "question": "Are there virtual/remote opportunities?",
            "answer": "Yes! Phone banking, social media, data entry, and creative work can all be done from home. Perfect if you have transportation or mobility constraints."
          },
          {
            "question": "What if I can only help on weekends?",
            "answer": "Perfect! Many volunteers are only available on weekends. We have canvassing, event support, and special projects specifically scheduled for weekends."
          },
          {
            "question": "Will I have to do public speaking?",
            "answer": "Only if you want to! Most volunteer roles involve one-on-one conversations or behind-the-scenes work. We'll never push you out of your comfort zone."
          },
          {
            "question": "Can I volunteer with friends or family?",
            "answer": "We encourage it! Group volunteering is more fun and effective. Sign up together and we'll keep you on the same teams."
          },
          {
            "question": "What about childcare during volunteer activities?",
            "answer": "We're working on childcare options for certain events. Let us know your needs when you sign up and we'll do our best to accommodate."
          },
          {
            "question": "How do I track my volunteer hours?",
            "answer": "We use a simple online system where you can log hours, see your impact stats, and track your progress on the leaderboard if you choose to participate."
          }
        ],
        "default_open": 0,
        "icon_style": "plus-minus",
        "animation": "slide-down"
      }
    },
