  "custom_css": "/* Volunteer Hub Custom Styles */\n.cp-volunteer-hub {\n  font-family: 'Inter', -apple-system, sans-serif;\n}\n\n.cp-volunteer-hub .cp-opportunity-card {\n  transition: transform 0.3s, box-shadow 0.3s;\n}\n\n.cp-volunteer-hub .cp-opportunity-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 8px 24px rgba(0, 163, 42, 0.2);\n}\n\n.cp-volunteer-hub .cp-spots-indicator {\n  background: linear-gradient(90deg, #00a32a 0%, #46b450 100%);\n  height: 4px;\n  border-radius: 2px;\n}\n\n.cp-volunteer-hub .cp-leaderboard-row:nth-child(1) { background: #fff9e6; }\n.cp-volunteer-hub .cp-leaderboard-row:nth-child(2) { background: #f5f5f5; }\n.cp-volunteer-hub .cp-leaderboard-row:nth-child(3) { background: #fff3e6; }",
  "responsive_settings": {
    "mobile": {
      "hide_components": [],
      "stack_order": "default",
      "adjustments": {
        "hero_stats_layout": "vertical",
        "opportunities_columns": 1,
        "stats_columns": 2,
        "leaderboard_hide_columns": ["calls", "doors", "events"],
        "form_layout": "stacked"
      }
    },
    "tablet": {
      "adjustments": {
        "opportunities_columns": 2,
        "stats_columns": 2,
        "leaderboard_hide_columns": ["events"]
      }
    }
  },
  "seo": {
    "title": "Volunteer - Join Our Campaign Team",
    "description": "Make a real difference! Join thousands of volunteers helping to win this election. From phone banking to canvassing, find the perfect way to help.",
    "keywords": ["volunteer", "campaign volunteer", "grassroots organizing", "political activism", "get involved", "make a difference"],
    "og_image": "/assets/templates/og-volunteer-hub.jpg"
  },
  "integrations": {
    "crm_sync": true,
    "volunteer_management": "ngp_van",
    "email_autoresponder": {
      "enabled": true,
      "template": "volunteer_welcome",
      "delay": "immediate"
    },
    "calendar_sync": true,
    "mobile_app": "campaign_connect"
  },
  "analytics": {
    "conversion_goals": [
      {"name": "volunteer_signup", "event": "form_submit"},
      {"name": "opportunity_click", "event": "click"},
      {"name": "time_on_page", "threshold": 120}
    ]
  },
  "setup_instructions": [
    "1. Update volunteer statistics with real campaign data",
    "2. Add actual volunteer opportunities with correct details",
    "3. Include real volunteer testimonials with photos",
    "4. Configure volunteer management system integration (NGP VAN, etc.)",
    "5. Set up email autoresponder for new sign-ups",
    "6. Create leaderboard with opt-in system for privacy",
    "7. Test form submission and CRM integration",
    "8. Add calendar integration for event scheduling"
  ],
  "best_practices": [
    "Respond to volunteer sign-ups within 24 hours",
    "Keep opportunity descriptions specific and actionable",
    "Update impact statistics weekly",
    "Celebrate volunteer achievements publicly",
    "Make sign-up process as simple as possible",
    "Offer virtual options for accessibility",
    "Provide clear training and support",
    "Show appreciation regularly"
  ],
  "performance_benchmarks": {
    "conversion_rate": "8-12%",
    "average_time_on_page": "3-5 minutes",
    "mobile_signups": "45-55%",
    "return_visitors": "15-20%"
  },
  "credits": {
    "designer": "CampaignPress Grassroots Team",
    "based_on": "Top-performing volunteer recruitment pages",
    "tested_with": "500+ campaigns",
