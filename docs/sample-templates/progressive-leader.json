  "custom_css": "/* Template-specific custom styles */\n.cp-progressive-leader {\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n}\n\n.cp-progressive-leader h1 {\n  font-weight: 800;\n  letter-spacing: -0.02em;\n}\n\n.cp-progressive-leader .cp-donation-tier.popular {\n  transform: scale(1.05);\n  box-shadow: 0 8px 24px rgba(34, 113, 177, 0.3);\n}",
  "responsive_settings": {
    "mobile": {
      "hide_components": [],
      "stack_order": "default",
      "adjustments": {
        "hero_height": "60vh",
        "stats_columns": 2,
        "issues_tabs_vertical": true,
        "testimonials_columns": 1
      }
    },
    "tablet": {
      "adjustments": {
        "stats_columns": 2,
        "testimonials_columns": 2
      }
    }
  },
  "seo": {
    "title": "{{Candidate Name}} - Fighting for Real Change",
    "description": "Join our grassroots movement for healthcare, climate action, economic justice, and more. Together we can build a future that works for everyone.",
    "keywords": ["progressive", "democratic", "campaign", "healthcare", "climate", "economic justice"],
    "og_image": "/assets/templates/og-progressive-leader.jpg"
  },
  "setup_instructions": [
    "1. Replace placeholder candidate name with actual name",
    "2. Update video URL with campaign announcement video",
    "3. Customize stats with real campaign numbers",
    "4. Edit policy positions to match candidate's platform",
    "5. Add real testimonials and endorsement logos",
    "6. Connect payment processor (ActBlue/NGP VAN)",
    "7. Link social media accounts",
    "8. Update all placeholder images with campaign photos"
  ],
  "recommended_plugins": [
    "ActBlue Integration",
    "Google Analytics",
    "Social Media Auto-Poster",
    "Event Calendar Pro"
  ],
