      "variant": "accordion",
      "order": 6,
      "settings": {
        "section_headline": "Common Questions",
        "background": "#f8f9fa",
        "padding": "60px-20px-80px",
        "layout": "single-column",
        "faqs": [
          {
            "question": "Is my donation secure?",
            "answer": "Yes! We use industry-leading encryption and secure payment processing through ActBlue. Your information is safe and private."
          },
          {
            "question": "Are donations tax-deductible?",
            "answer": "No, contributions to political campaigns are not tax-deductible for federal income tax purposes."
          },
          {
            "question": "What's the maximum I can donate?",
            "answer": "Federal law limits individual contributions to $1,000 per election. This includes both primary and general elections."
          },
          {
            "question": "Can I donate if I'm not a US citizen?",
            "answer": "Unfortunately, no. Federal law prohibits campaigns from accepting contributions from foreign nationals."
          },
          {
            "question": "How will my donation be used?",
            "answer": "100% of your contribution goes directly to campaign operations: voter outreach, advertising, field organizing, and GOTV efforts."
          },
          {
            "question": "Can I cancel my recurring donation?",
            "answer": "Absolutely! You can cancel anytime by clicking the link in your receipt email or contacting us at donations@campaign.com."
          }
        ],
        "default_open": 0,
        "icon_style": "plus-minus",
        "animation": "slide-down"
      }
    }
