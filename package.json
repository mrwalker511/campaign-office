{
  "name": "campaignpress",
  "version": "2.0.0",
  "description": "Political WordPress Theme with Advanced Blocks",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:css": "postcss assets/css/app.css -o assets/css/dist/tailwind.css --config build/postcss.config.js",
    "watch:css": "postcss assets/css/app.css -o assets/css/dist/tailwind.css --config build/postcss.config.js --watch",
    "dev": "vite --config build/vite.config.js",
    "build": "npm run build:css && vite build --config build/vite.config.js",
    "preview": "vite preview --config build/vite.config.js",
    "speed-optimize": "npm run optimize:images && npm run optimize:css && npm run optimize:js && npm run critical-css && npm run lighthouse",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:css": "node scripts/optimize-css.js",
    "optimize:js": "node scripts/optimize-js.js",
    "critical-css": "node scripts/generate-critical-css.js",
    "lighthouse": "node scripts/lighthouse-test.js",
    "pre-optimize": "node scripts/pre-optimization-check.js",
    "post-optimize": "node scripts/post-optimization-check.js",
    "clean": "node scripts/clean.js",
    "test": "npm run test:php && npm run test:js && npm run test:lint",
    "test:all": "npm run test:lint && npm run test:js && npm run test:php && node tests/theme-check.js",
    "test:quick": "npm run lint:js && npm run lint:css && npm run test:js",
    "test:php": "composer test",
    "test:js": "jest --config tests/jest.config.js",
    "test:js:watch": "jest --config tests/jest.config.js --watch",
    "test:js:coverage": "jest --config tests/jest.config.js --coverage",
    "test:lint": "npm run lint:js && npm run lint:css && composer phpcs",
    "test:a11y": "node tests/accessibility/run-a11y-tests.js",
    "test:e2e": "playwright test --config tests/playwright.config.js",
    "test:e2e:headed": "playwright test --config tests/playwright.config.js --headed",
    "test:e2e:ui": "playwright test --config tests/playwright.config.js --ui",
    "test:performance": "node tests/performance/run-performance-tests.js",
    "lint:js": "eslint \"assets/js/**/*.js\" \"assets/react/**/*.{js,jsx}\" \"blocks/**/*.js\" --config build/eslint.config.json",
    "lint:js:fix": "eslint \"assets/js/**/*.js\" \"assets/react/**/*.{js,jsx}\" \"blocks/**/*.js\" --config build/eslint.config.json --fix",
    "lint:css": "stylelint \"assets/css/**/*.css\" --config build/stylelint.config.json",
    "lint:css:fix": "stylelint \"assets/css/**/*.css\" --config build/stylelint.config.json --fix"
  },
  "keywords": [
    "wordpress",
    "theme",
    "political",
    "campaign"
  ],
  "author": "CampaignPress Team",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@wordpress/scripts": "^31.1.0",
    "@wordpress/server-side-render": "^6.12.0",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.8.3",
    "axe-playwright": "^1.2.3",
    "chrome-launcher": "^1.1.0",
    "critical": "^6.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-react": "^7.33.2",
    "glob": "^10.3.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^13.0.1",
    "lightningcss": "^1.23.0",
    "pa11y": "^9.0.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.2.4",
    "purgecss": "^5.0.0",
    "sharp": "^0.33.1",
    "stylelint": "^16.1.0",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@wordpress/block-editor": "^12.20.0",
    "@wordpress/blocks": "^12.29.0",
    "@wordpress/components": "^27.0.0",
    "@wordpress/element": "^5.29.0",
    "@wordpress/i18n": "^4.52.0",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
