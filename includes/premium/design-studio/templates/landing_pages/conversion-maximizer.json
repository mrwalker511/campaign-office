  "exit_intent_popup": {
    "enabled": true,
    "trigger": "exit_intent",
    "headline": "Wait! Before You Go...",
    "message": "We're just $12,347 away from our goal. Can you spare $25 to help us get there?",
    "quick_amounts": [10, 25, 50, 100],
    "image": "/assets/placeholders/candidate-earnest.jpg",
    "dismiss_text": "Maybe later",
    "cookie_duration": 7
  },
  "custom_css": "/* Conversion-optimized styles */\n.cp-conversion-maximizer .cp-donation-tier.popular {\n  transform: scale(1.1);\n  border: 3px solid #d63638;\n  box-shadow: 0 12px 28px rgba(214, 54, 56, 0.3);\n  position: relative;\n}\n\n.cp-conversion-maximizer .cp-matching-banner {\n  background: linear-gradient(90deg, #ff6b6b 0%, #d63638 100%);\n  color: white;\n  font-weight: bold;\n  padding: 12px;\n  text-align: center;\n  animation: pulse 2s infinite;\n}\n\n.cp-conversion-maximizer .cp-urgency-indicator {\n  background: #fff3cd;\n  border-left: 4px solid #ff3333;\n  padding: 10px 15px;\n  margin-bottom: 20px;\n  font-weight: 600;\n}\n\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.8; }\n}",
