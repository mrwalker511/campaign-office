    "og_image": "/assets/templates/og-conservative-champion.jpg"
  },
  "setup_instructions": [
    "1. Replace candidate name and photo throughout",
    "2. Update conservative ratings and endorsements with real data",
    "3. Customize core values to match candidate priorities",
    "4. Edit issue positions with specific policy details",
    "5. Add real endorsement logos and quotes",
    "6. Configure WinRed payment processor",
    "7. Update volunteer opportunities with local details",
    "8. Replace all placeholder images with campaign photos"
  ],
