{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "campaignpress/event-organizer",
    "version": "1.0.0",
    "title": "Event Organizer",
    "category": "campaign-office",
    "icon": "calendar-alt",
    "description": "Showcase events with RSVP functionality and map integration.",
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "attributes": {
        "upcomingEvents": {
            "type": "array",
            "default": []
        },
        "showMap": {
            "type": "boolean",
            "default": true
        },
        "rsvpEnabled": {
            "type": "boolean",
            "default": true
        }
    },
    "textdomain": "campaign-office",
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "render": "file:./render.php",
    "style": "file:./style.css"
}