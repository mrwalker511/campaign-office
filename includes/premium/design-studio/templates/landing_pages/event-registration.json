{
  "template_key": "event_registration",
  "template_name": "Event Registration",
  "template_description": "Single event registration landing page with RSVP form, event details, and social sharing.",
  "category": "landing_pages",
  "campaign_type": "all",
  "election_level": "all",
  "tags": ["event", "registration", "rsvp", "rally", "town-hall"],
  "is_premium": true,
  "featured": false,
  "difficulty": "beginner",
  "estimated_setup_time": "5 minutes",
  "color_scheme": {
    "primary": "#2271b1"
  },
  "components": [
    {
      "type": "hero",
      "variant": "centered",
      "order": 1,
      "settings": {
        "headline": "Join Us at [Event Name]",
        "subheadline": "[Date] • [Time] • [Location]",
        "background_image": "/assets/placeholders/rally.jpg",
        "buttons": [
          {"text": "RSVP Now", "style": "primary-large", "link": "#rsvp"}
        ]
      }
    },
    {
      "type": "events",
      "variant": "featured",
      "order": 2,
      "settings": {
        "section_headline": "Event Details",
        "event_info": {
          "title": "[Event Name]",
          "date": "[Full Date]",
          "time": "[Start Time] - [End Time]",
          "location": "[Venue Name]\n[Address]\n[City, State ZIP]",
          "description": "Join us for an exciting rally featuring [candidate], special guests, and community leaders. Free and open to the public.",
          "parking": "Free parking available",
          "accessibility": "Wheelchair accessible venue"
        }
      }
    },
    {
      "type": "cta",
      "variant": "card",
      "order": 3,
      "settings": {
        "section_id": "rsvp",
        "headline": "Reserve Your Spot",
        "form": {
          "enabled": true,
          "fields": [
            {"name": "name", "type": "text", "label": "Full Name", "required": true},
            {"name": "email", "type": "email", "label": "Email", "required": true},
            {"name": "phone", "type": "tel", "label": "Phone", "required": false},
            {"name": "guests", "type": "number", "label": "Number of Guests", "required": true, "default": 1}
          ],
          "submit_text": "RSVP Now"
        }
      }
    },
    {
      "type": "cta",
      "variant": "inline",
      "order": 4,
      "settings": {
        "headline": "Spread the Word",
        "social_sharing": {"enabled": true}
      }
    }
  ],
  "seo": {
    "title": "[Event Name] - {{Candidate Name}} Campaign",
    "description": "Join us at [event]. RSVP now to reserve your spot."
  },
  "credits": {"version": "1.0.0"}
}
