{
  "template_key": "email_signup",
  "template_name": "Email Signup",
  "template_description": "Email list building landing page. Optimized for growing your supporter base with minimal friction.",
  "category": "landing_pages",
  "campaign_type": "all",
  "election_level": "all",
  "tags": ["email", "signup", "list-building", "subscribers", "newsletter"],
  "is_premium": true,
  "featured": false,
  "difficulty": "beginner",
  "estimated_setup_time": "3 minutes",
  "conversion_optimized": true,
  "color_scheme": {
    "primary": "#0073aa"
  },
  "components": [
    {
      "type": "hero",
      "variant": "centered",
      "order": 1,
      "settings": {
        "headline": "Stay Connected",
        "subheadline": "Get campaign updates, event invitations, and ways to get involved",
        "height": "60vh"
      }
    },
    {
      "type": "cta",
      "variant": "card",
      "order": 2,
      "settings": {
        "headline": "Join Our Email List",
        "form": {
          "enabled": true,
          "fields": [
            {"name": "email", "type": "email", "label": "Email Address", "required": true, "placeholder": "your@email.com"},
            {"name": "zip", "type": "text", "label": "Zip Code", "required": true, "placeholder": "12345"}
          ],
          "submit_text": "Sign Me Up",
          "privacy_note": "We respect your privacy. Unsubscribe anytime."
        }
      }
    },
    {
      "type": "testimonials",
      "variant": "carousel",
      "order": 3,
      "settings": {
        "section_headline": "Why Subscribe?",
        "testimonials": [
          {"quote": "Best way to stay informed about the campaign", "author": "Supporter"},
          {"quote": "Love getting the weekly updates", "author": "Volunteer"}
        ]
      }
    }
  ],
  "seo": {
    "title": "Join Our Email List - {{Candidate Name}}",
    "description": "Sign up to receive campaign updates and stay connected."
  },
  "credits": {"version": "1.0.0"}
}
