# CampaignPress Build Scripts Configuration
# Copy this file to .env and customize for your environment

# Option 1: Direct URL (takes priority)
# SITE_URL=http://localhost:8881

# Option 2: Named host environment (from config.js)
# Available: local, localwp, staging, production
# HOST_ENV=local

# Option 3: Custom pages configuration (JSON file path)
# PAGES_CONFIG=./custom-pages.json

# Examples for different environments:
# ─────────────────────────────────────

# Local WordPress (wp-env or similar)
# SITE_URL=http://localhost:8888

# LocalWP / Flywheel
# SITE_URL=http://campaignpress.local

# XAMPP / MAMP
# SITE_URL=http://localhost/campaignpress

# Staging server
# SITE_URL=https://staging.campaignpress.com

# Production
# SITE_URL=https://campaignpress.com
